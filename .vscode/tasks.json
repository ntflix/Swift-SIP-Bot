{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G",
                "Ninja",
                ".."
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "problemMatcher": []
        },
        {
            "label": "run: MyBaresipApp",
            "type": "shell",
            "command": "./MyBaresipApp",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "cmake: build"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "cmake: configure"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}